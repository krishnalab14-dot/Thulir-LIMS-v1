# Thulir LIMS Web — environment template (optional; the Vite dev proxy and
# API defaults work out of the box). Copy to .env only to override:
#   cp apps/web/env.example apps/web/.env

# Full API base URL when NOT using the Vite /api dev proxy (defaults to /api).
VITE_API_URL=

# Dev-only: target of the Vite /api proxy (defaults to http://localhost:3000).
VITE_API_PROXY_TARGET=http://localhost:3000

# Stage 7: no VITE_ORG_ID — the retired `x-organization-id` header is gone.
# Tenant context comes from the access token issued by POST /api/auth/login.
