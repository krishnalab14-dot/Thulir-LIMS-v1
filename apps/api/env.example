# Thulir LIMS API — environment template. Copy to .env and adjust for your machine:
#   cp apps/api/env.example apps/api/.env

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://thulir:thulir@localhost:5432/thulir_lims?schema=public"

# HTTP port the API listens on (0.0.0.0)
PORT=3000

# Until the auth stage lands, every request runs inside this organization's
# tenant context unless the caller sends an `x-organization-id` header.
DEFAULT_ORG_ID="org_demo"
