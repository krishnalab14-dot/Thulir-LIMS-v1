// Thulir LIMS — Prisma schema (Stage 1 tables only)
//
// Multi-tenancy: every model with an `organizationId` column is tenant-scoped
// by the fail-closed Prisma extension in src/prisma/tenant-scope.extension.ts.
// Queries against these models throw unless a tenant context is in scope.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  admin
  lab_manager
  pathologist
  technician
  receptionist
}

enum Gender {
  male
  female
  other
}

// How a test's result is captured/validated at Result Entry (Stage 3):
//   numeric → validated against a resolved reference range (and critical
//             thresholds captured now for a later alerting stage)
//   options → validated against resultOptions
//   text    → free-form, no range/options
enum ResultType {
  numeric
  options
  text
}

enum PartyType {
  doctor
  hospital
  reference_lab
  corporate
  insurance_tpa
  staff
}

enum OrderStatus {
  billed
  collected
  entered
  partially_verified
  verified
  partially_approved
  approved
}

enum OrderTestStatus {
  pending
  entered
  verified
  approved
}

enum InvoiceStatus {
  paid
  partial
  due
}

enum PaymentMode {
  cash
  upi
  card
  bank_transfer
  insurance
}

enum SampleStatus {
  pending_collection
  collected
  rejected
}

enum RejectionReason {
  hemolyzed
  clotted
  insufficient_quantity
  mislabeled
  container_leaked
  other
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users       User[]
  patients    Patient[]
  tests       MasterTest[]
  packages    MasterTestPackage[]
  sampleTypes       SampleType[]
  parties           Party[]
  orders            Order[]
  orderTests        OrderTest[]
  invoices          Invoice[]
  payments          Payment[]
  samples           Sample[]
  testSpecifications TestSpecification[]
  billGroups        BillGroup[]
}

model User {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  staffCode        String?      // auto-generated: <org-prefix>-ST-<NNNN>
  // Globally unique (not per-org): a username resolves to exactly one user, so
  // login has no "which org am I logging into" ambiguity — the org is read
  // off the matched user's row, not guessed from the request.
  username         String       @unique
  passwordHash     String
  role             Role
  isActive         Boolean      @default(true)
  // Stage 7 real auth: opaque refresh tokens are stored ONLY as a sha-256
  // hash (never raw), one per user, rotated on every refresh. lastLoginAt
  // stamps the most recent successful login.
  refreshTokenHash String?
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())

  @@unique([organizationId, staffCode])
  @@index([organizationId])
}

model Patient {
  id                 String    @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  patientUid         String    @unique // auto-generated: <org-prefix>-<year>-<sequential>, e.g. THL-2026-0001
  title              String?
  firstName          String
  lastName           String
  dob                DateTime? // primary source of truth; ageAtRegistration derived when DOB given
  ageAtRegistration  Int?      // fallback when only age was provided at registration
  gender             Gender
  mobile             String
  email              String?
  address            String?
  externalMrn        String?
  abhaNumber         String?
  createdAt          DateTime  @default(now())
  createdBy          String

  orders Order[]

  @@index([organizationId])
  @@index([mobile])
}

model SampleType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // e.g. "EDTA Blood", "Serum", "Urine"
  code           String? // short tube code used in sample barcodes, e.g. "EDTA", "SER"
  active         Boolean      @default(true)

  tests   MasterTest[]
  samples Sample[]

  @@index([organizationId])
}

// Minimal Test Master interface for Stage 1 only — full parameter-level
// schema (result types, specifications, calculations) is a later stage.
model MasterTest {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  testCode             String
  testName             String
  currentPrice         Decimal      @db.Decimal(12, 2)
  requiredSampleTypeId String?
  requiredSampleType   SampleType?  @relation(fields: [requiredSampleTypeId], references: [id])
  // Stage 2.1 per-test sample override: false (default) = shares a tube with
  // other tests of the same sample type on the same order; true = always gets
  // its own dedicated Sample/tube, even when another test on the same order
  // has the identical sampleTypeId.
  requiresDedicatedSample Boolean      @default(false)
  active               Boolean      @default(true)

  // Stage 2.5 Test Master extension — how results are captured/validated:
  //   resultType numeric → resolved reference range (defaults or age/sex
  //     specifications) + critical thresholds (captured now, consumed by a
  //     later critical-alerting stage)
  //   resultType options → resultOptions is the valid choice list
  //   resultType text    → free-form, nothing else applies
  resultType     ResultType @default(numeric)
  resultOptions  String[]   @default([])
  // Stage 3: parallel array to resultOptions marking which choices are
  // ABNORMAL (e.g. a qualitative "Positive" option). Purely additive — the
  // flat resultOptions list is unchanged. Snapshot at order time; Result
  // Entry uses it for visual flagging (abnormal option styling) and "Mark
  // All Normal" (fills with the first non-abnormal option).
  resultOptionsAbnormal String[]   @default([])
  defaultRefLow  Float?
  defaultRefHigh Float?
  criticalLow    Float?
  criticalHigh   Float?
  // Stage 3 follow-up: display unit for numeric results (mg/dL, g/dL, %, …).
  // Free text, nullable — options/text-type tests often don't need one. It is
  // snapshotted onto OrderTest.snapshottedUnit at order time (same
  // non-negotiable snapshot principle as price/range) and only ever read
  // from the snapshot afterwards.
  unit           String?

  specifications TestSpecification[]
  packageItems   MasterTestPackageItem[]
  orderTests     OrderTest[]

  @@index([organizationId])
}

// Age/sex-scoped reference ranges (Stage 2.5). `sex` reuses the Patient
// `Gender` enum — its value set (male/female/other) is identical to the spec's
// proposed `Sex`, so no near-duplicate enum is created; patient `gender` maps
// 1:1 into this column. `sex = null` means "applies to any sex". Overlapping
// rows for the same test + sex-tier + age-range are rejected at save time, so
// Result Entry never has to disambiguate ranges at runtime.
model TestSpecification {
  id            String   @id @default(cuid())
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id])
  testId        String
  test          MasterTest @relation(fields: [testId], references: [id])
  ageMinYears   Int
  ageMaxYears   Int
  sex           Gender?
  refLow        Float
  refHigh       Float

  @@index([organizationId])
  @@index([testId])
}

model MasterTestPackage {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  packageCode    String
  packageName    String
  packagePrice   Decimal                  @db.Decimal(12, 2)
  items          MasterTestPackageItem[]
  active         Boolean                  @default(true)

  @@index([organizationId])
}

model MasterTestPackageItem {
  id        String             @id @default(cuid())
  packageId String
  package   MasterTestPackage  @relation(fields: [packageId], references: [id])
  testId    String
  test      MasterTest         @relation(fields: [testId], references: [id])

  @@index([packageId])
}

model Party {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  doctorCode     String?      // auto-generated: <org-prefix>-DR-<NNNN>
  name           String
  type           PartyType
  active         Boolean      @default(true)

  // Stage 8: portal auth for referrers. Both null until an admin explicitly
  // sets up portal access via POST /api/parties/:id/portal-access. Username
  // is globally unique (same approach as staff User.username). Password is
  // stored only as a bcrypt hash — never returned after the initial
  // generation (admin sees it once, relays out-of-band).
  portalUsername     String?  @unique
  portalPasswordHash String?

  referredOrders Order[]

  @@unique([organizationId, doctorCode])
  @@index([organizationId])
}

// Order.status is a DERIVED rollup computed from the set of OrderTest.status
// values (see src/orders/order-status.util.ts). It is never set independently
// by callers; it is recomputed whenever an OrderTest changes.
model Order {
  id               String       @id @default(cuid())

  // Human-friendly sequential bill/invoice reference (e.g. THU-BILL-2026-0001),
  // generated with the same atomic UidCounter pattern as patientUid. Nullable:
  // orders created before this field existed keep null; every new order gets one.
  billNo           String?      @unique

  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  patientId        String
  patient          Patient      @relation(fields: [patientId], references: [id])
  referrerPartyId  String?
  referrerParty    Party?       @relation(fields: [referrerPartyId], references: [id])
  clinicalNotes    String?
  isUrgent         Boolean      @default(false)
  status           OrderStatus  @default(billed) // derived rollup, see above
  subtotal         Decimal      @db.Decimal(12, 2)
  discountPercent  Decimal      @db.Decimal(5, 2) @default(0)
  totalAmount      Decimal      @db.Decimal(12, 2)
  createdBy        String
  createdAt        DateTime     @default(now())

  // Audit: which staff member authorized a discretionary discount (> 0).
  // Always set server-side from the authenticated user's JWT — never
  // trusted from the client. Required when discountPercent > 0.
  discountAuthorizedBy String?

  // Informational: when the patient/referrer can expect the report.
  // Not enforced against anything yet — captured at registration for
  // later display on the portal and patient communication.
  expectedReportDate DateTime?

  // §1 Scheduled collection estimate — when the patient is expected to
  // come back for sample collection (NOT the real collection timestamp,
  // which is Stage 2's Sample.collectedAt). Purely informational.
  scheduledCollectionAt DateTime?

  // §3 Inpatient context (hospital-use fields). Collapsed by default in
  // the Demographics step — not shown for routine lab walk-ins.
  patientType String?   // e.g. "IP", "OP"
  wardDesc    String?
  bedNo       String?
  ipOpNo      String?

  // §4 Source — simple lead-tracking: "Walk-in", "Referral", etc.
  source String?

  // Consolidated billing: links this order into a BillGroup for
  // multi-patient billing. null = standalone (the common case).
  billGroupId String?
  billGroup   BillGroup? @relation(fields: [billGroupId], references: [id])

  // Stage 6: set once on the FIRST successful GET /orders/:id/report — the
  // report's issue date, distinct from approvedAt (approval can predate the
  // first print by hours/days). Displayed on the report as "Report issued"
  // and echoed by the public verification endpoint as reportDate.
  reportGeneratedAt DateTime?

  orderTests OrderTest[]
  samples    Sample[]
  invoice    Invoice?

  @@index([organizationId])
  @@index([patientId])
}

// Per-test workflow granularity: pending → entered → verified → approved.
// snapshottedPrice / testNameSnapshot are captured at order time and are
// NEVER re-read live from MasterTest afterwards (snapshot principle). The
// Stage 2.5 result fields are snapshotted the same way — the resolved range
// and options are frozen at order time; a later Masters change to the test's
// ranges never affects already-placed orders.
model OrderTest {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  testId           String
  test             MasterTest     @relation(fields: [testId], references: [id])
  testNameSnapshot String
  snapshottedPrice Decimal        @db.Decimal(12, 2)
  status           OrderTestStatus @default(pending)
  sampleId         String?
  sample           Sample?        @relation(fields: [sampleId], references: [id])

  // Stage 2.5 result snapshots (nullable until populated by the order
  // transaction; always set for new orders). resultType copied directly;
  // resultOptions copied when resultType = options; refLow/refHigh resolved
  // per §2 (spec match → any-sex spec → default) only for numeric;
  // critical thresholds copied directly for numeric (nothing consumes them
  // yet — captured now so a later alerting stage needs no backfill).
  snapshottedResultType     ResultType?
  snapshottedResultOptions  Json?
  snapshottedResultOptionsAbnormal String[] @default([])
  snapshottedRefLow         Float?
  snapshottedRefHigh        Float?
  snapshottedCriticalLow    Float?
  snapshottedCriticalHigh   Float?
  // Stage 3 follow-up: unit copied from MasterTest.unit at order time — the
  // same snapshot principle as price/range; never re-read live afterwards.
  snapshottedUnit            String?

  // Stage 3 result capture: resultValue is interpreted per
  // snapshottedResultType (numeric → numeric string, options → one of the
  // snapshotted options, text → free text). enteredBy/enteredAt stamp the
  // save; status moves pending → entered (verified/approved are later
  // stages). Empty text is treated as "not yet entered" and reverts the row
  // to pending (never advances status).
  resultValue String?
  enteredBy   String?
  enteredAt   DateTime?

  // Stage 4 verification — the entered → verified transition (and its
  // reverse, verified → entered on reject-back). Per-test granularity, same
  // as result entry: OrderTest.status is the authoritative unit of
  // verification. verifiedBy/verifiedAt stamp the verify; verifyRejectedNote
  // records why a verified row was sent back to entry (cleared on the next
  // successful verify). resultValue is NEVER touched by reject-back — the
  // technician corrects the existing value through the normal Result Entry
  // save path (whose status guard NOT IN (verified, approved) permits
  // entered rows).
  verifiedBy         String?
  verifiedAt         DateTime?
  verifyRejectedNote String?

  // Stage 5 approval — the verified → approved transition (and its reverse,
  // approved/verified → entered on a pathologist reject-back). Per-test
  // granularity, same as result entry and verification. approvedBy/approvedAt
  // stamp the approve; approvalSignatureStamp is a deterministic recorded-
  // event reference (hash of orderTestId + actor + timestamp + signature
  // reference) — enough to prove THIS specific approval event happened for
  // later Report rendering and audits, NOT a legal e-signature system.
  approvedBy             String?
  approvedAt             DateTime?
  approvalSignatureStamp String?

  @@index([organizationId])
  @@index([orderId])
  @@index([sampleId])
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id])
  subtotal        Decimal       @db.Decimal(12, 2)
  discountPercent Decimal       @db.Decimal(5, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(due)

  payments Payment[]

  @@index([organizationId])
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  collectedBy    String
  collectedAt    DateTime     @default(now())

  splits PaymentSplit[]

  @@index([organizationId])
  @@index([invoiceId])
}

// PaymentSplit is NOT itself tenant-scoped: it has no organizationId column.
// Its tenancy is inherited from its parent Payment. This is intentional.
model PaymentSplit {
  id        String      @id @default(cuid())
  paymentId String
  payment   Payment     @relation(fields: [paymentId], references: [id])
  mode      PaymentMode
  amount    Decimal     @db.Decimal(12, 2)

  @@index([paymentId])
}

// BillGroup: optional grouping for consolidated billing (multiple patients
// billed together, e.g. a family visit). When billGroupId is null the order
// is standalone — the common case. When set, the group's combined bill
// displays all linked orders and allows cross-order payment distribution.
model BillGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdBy      String
  createdAt      DateTime     @default(now())

  orders Order[]

  @@index([organizationId])
}

// One Sample per distinct required sample type among an order's NON-dedicated
// tests, plus one Sample per test flagged requiresDedicatedSample (Stage 2.1).
// Barcode is deterministic (order-id prefix + sampleType code, with the test id
// appended for dedicated samples; -R2/-R3… on recollection), generated inside
// the order transaction. Rejections keep the rejected row for audit and
// auto-create a recollection linked via recollectionOfSampleId.
model Sample {
  id                     String           @id @default(cuid())
  organizationId         String
  organization           Organization     @relation(fields: [organizationId], references: [id])
  orderId                String
  order                  Order            @relation(fields: [orderId], references: [id])
  sampleTypeId           String
  sampleType             SampleType       @relation(fields: [sampleTypeId], references: [id])
  barcodeValue           String           @unique
  status                 SampleStatus     @default(pending_collection)
  collectedBy            String?
  collectedAt            DateTime?
  rejectedReason         RejectionReason?
  rejectedReasonNote     String?
  rejectedBy             String?
  rejectedAt             DateTime?
  recollectionOfSampleId String?
  recollectionOf         Sample?          @relation("SampleRecollection", fields: [recollectionOfSampleId], references: [id])
  recollections          Sample[]         @relation("SampleRecollection")
  orderTests             OrderTest[]
  createdAt              DateTime         @default(now())

  @@index([organizationId])
  @@index([orderId])
  @@index([status])
  @@index([recollectionOfSampleId])
}

// Internal counter table backing org-scoped, year-scoped sequential human IDs
// (patientUid uses key `${orgId}:${year}`; the order billNo reuses the same
// table under a separate `${orgId}:bill:${year}` namespace). Incremented with a
// single atomic INSERT ... ON CONFLICT ... RETURNING so concurrent writes can
// never produce a duplicate identifier.
model UidCounter {
  id      String @id // `${organizationId}:${year}`
  orgId   String
  year    Int
  counter Int    @default(0)
}

// Generic lookup list — configurable dropdown options (titles, rejection
// reasons, etc.) scoped per organisation. One row per option; the `category`
// field discriminates between different lists (e.g. "title", "rejection_reason").
model LookupItem {
  id             String  @id @default(cuid())
  organizationId String
  category       String  // e.g. "title", "rejection_reason"
  value          String  // the displayed label
  sortOrder      Int     @default(0)
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, category, value])
  @@index([organizationId, category])
}
