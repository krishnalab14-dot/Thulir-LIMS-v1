# Thulir LIMS API — environment template. Copy to .env and adjust for your machine:
#   cp apps/api/env.example apps/api/.env

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://thulir:thulir@localhost:5432/thulir_lims?schema=public"

# HTTP port the API listens on (0.0.0.0)
PORT=3000

# Until the auth stage lands, every request runs inside this organization's
# tenant context unless the caller sends an `x-organization-id` header.
DEFAULT_ORG_ID="org_demo"

# Supabase (auth + storage backend — the LIMS database stays Prisma-managed
# PostgreSQL; Supabase is consumed server-side by the API). Paste the project
# values into the Freebuff Keys/API-keys tab (or apps/api/.env locally).
# Both key generations work: legacy JWT (anon / service_role) and the new
# non-JWT format (sb_publishable_... replaces anon, sb_secret_... replaces
# service_role — send these on the `apikey` header, which supabase-js does).
#   SUPABASE_URL            https://<project-ref>.supabase.co  (Settings → API Keys → API URL)
#   SUPABASE_ANON_KEY       the public "publishable" key (sb_publishable_...) or legacy anon key
#   SUPABASE_SERVICE_ROLE_KEY  the secret key (sb_secret_...) or legacy service_role key — server-side only
#   SUPABASE_PROJECT_REF    the short project reference (e.g. abcdefgh)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROJECT_REF=""
