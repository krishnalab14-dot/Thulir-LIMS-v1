// Thulir LIMS — Prisma schema (Stage 1 tables only)
//
// Multi-tenancy: every model with an `organizationId` column is tenant-scoped
// by the fail-closed Prisma extension in src/prisma/tenant-scope.extension.ts.
// Queries against these models throw unless a tenant context is in scope.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  admin
  pathologist
  technician
  receptionist
}

enum Gender {
  male
  female
  other
}

enum PartyType {
  doctor
  hospital
  corporate
  insurance_tpa
}

enum OrderStatus {
  billed
  collected
  entered
  partially_verified
  verified
  partially_approved
  approved
}

enum OrderTestStatus {
  pending
  entered
  verified
  approved
}

enum InvoiceStatus {
  paid
  partial
  due
}

enum PaymentMode {
  cash
  upi
  card
  bank_transfer
  insurance
}

enum SampleStatus {
  pending_collection
  collected
  rejected
}

enum RejectionReason {
  hemolyzed
  clotted
  insufficient_quantity
  mislabeled
  container_leaked
  other
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users       User[]
  patients    Patient[]
  tests       MasterTest[]
  packages    MasterTestPackage[]
  sampleTypes SampleType[]
  parties     Party[]
  orders      Order[]
  orderTests  OrderTest[]
  invoices    Invoice[]
  payments    Payment[]
  samples     Sample[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  username       String
  passwordHash   String
  role           Role
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Patient {
  id                 String    @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  patientUid         String    @unique // auto-generated: <org-prefix>-<year>-<sequential>, e.g. THL-2026-0001
  title              String?
  firstName          String
  lastName           String
  dob                DateTime? // primary source of truth; ageAtRegistration derived when DOB given
  ageAtRegistration  Int?      // fallback when only age was provided at registration
  gender             Gender
  mobile             String
  email              String?
  address            String?
  externalMrn        String?
  abhaNumber         String?
  createdAt          DateTime  @default(now())
  createdBy          String

  orders Order[]

  @@index([organizationId])
  @@index([mobile])
}

model SampleType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // e.g. "EDTA Blood", "Serum", "Urine"
  code           String? // short tube code used in sample barcodes, e.g. "EDTA", "SER"
  active         Boolean      @default(true)

  tests   MasterTest[]
  samples Sample[]

  @@index([organizationId])
}

// Minimal Test Master interface for Stage 1 only — full parameter-level
// schema (result types, specifications, calculations) is a later stage.
model MasterTest {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  testCode             String
  testName             String
  currentPrice         Decimal      @db.Decimal(12, 2)
  requiredSampleTypeId String?
  requiredSampleType   SampleType?  @relation(fields: [requiredSampleTypeId], references: [id])
  active               Boolean      @default(true)

  packageItems MasterTestPackageItem[]
  orderTests   OrderTest[]

  @@index([organizationId])
}

model MasterTestPackage {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  packageCode    String
  packageName    String
  packagePrice   Decimal                  @db.Decimal(12, 2)
  items          MasterTestPackageItem[]
  active         Boolean                  @default(true)

  @@index([organizationId])
}

model MasterTestPackageItem {
  id        String             @id @default(cuid())
  packageId String
  package   MasterTestPackage  @relation(fields: [packageId], references: [id])
  testId    String
  test      MasterTest         @relation(fields: [testId], references: [id])

  @@index([packageId])
}

model Party {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  type           PartyType
  active         Boolean      @default(true)

  referredOrders Order[]

  @@index([organizationId])
}

// Order.status is a DERIVED rollup computed from the set of OrderTest.status
// values (see src/orders/order-status.util.ts). It is never set independently
// by callers; it is recomputed whenever an OrderTest changes.
model Order {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  patientId        String
  patient          Patient      @relation(fields: [patientId], references: [id])
  referrerPartyId  String?
  referrerParty    Party?       @relation(fields: [referrerPartyId], references: [id])
  clinicalNotes    String?
  isUrgent         Boolean      @default(false)
  status           OrderStatus  @default(billed) // derived rollup, see above
  subtotal         Decimal      @db.Decimal(12, 2)
  discountPercent  Decimal      @db.Decimal(5, 2) @default(0)
  totalAmount      Decimal      @db.Decimal(12, 2)
  createdBy        String
  createdAt        DateTime     @default(now())

  orderTests OrderTest[]
  samples    Sample[]
  invoice    Invoice?

  @@index([organizationId])
  @@index([patientId])
}

// Per-test workflow granularity: pending → entered → verified → approved.
// snapshottedPrice / testNameSnapshot are captured at order time and are
// NEVER re-read live from MasterTest afterwards (snapshot principle).
model OrderTest {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  testId           String
  test             MasterTest     @relation(fields: [testId], references: [id])
  testNameSnapshot String
  snapshottedPrice Decimal        @db.Decimal(12, 2)
  status           OrderTestStatus @default(pending)
  sampleId         String?
  sample           Sample?        @relation(fields: [sampleId], references: [id])

  @@index([organizationId])
  @@index([orderId])
  @@index([sampleId])
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id])
  subtotal        Decimal       @db.Decimal(12, 2)
  discountPercent Decimal       @db.Decimal(5, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(due)

  payments Payment[]

  @@index([organizationId])
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  collectedBy    String
  collectedAt    DateTime     @default(now())

  splits PaymentSplit[]

  @@index([organizationId])
  @@index([invoiceId])
}

// PaymentSplit is NOT itself tenant-scoped: it has no organizationId column.
// Its tenancy is inherited from its parent Payment. This is intentional.
model PaymentSplit {
  id        String      @id @default(cuid())
  paymentId String
  payment   Payment     @relation(fields: [paymentId], references: [id])
  mode      PaymentMode
  amount    Decimal     @db.Decimal(12, 2)

  @@index([paymentId])
}

// One Sample per distinct required sample type among an order's tests.
// Barcode is deterministic (order-id prefix + sampleType code, -R2/-R3… on
// recollection), generated inside the order transaction. Rejections keep the
// rejected row for audit and auto-create a recollection linked via
// recollectionOfSampleId.
model Sample {
  id                     String           @id @default(cuid())
  organizationId         String
  organization           Organization     @relation(fields: [organizationId], references: [id])
  orderId                String
  order                  Order            @relation(fields: [orderId], references: [id])
  sampleTypeId           String
  sampleType             SampleType       @relation(fields: [sampleTypeId], references: [id])
  barcodeValue           String           @unique
  status                 SampleStatus     @default(pending_collection)
  collectedBy            String?
  collectedAt            DateTime?
  rejectedReason         RejectionReason?
  rejectedReasonNote     String?
  rejectedBy             String?
  rejectedAt             DateTime?
  recollectionOfSampleId String?
  recollectionOf         Sample?          @relation("SampleRecollection", fields: [recollectionOfSampleId], references: [id])
  recollections          Sample[]         @relation("SampleRecollection")
  orderTests             OrderTest[]
  createdAt              DateTime         @default(now())

  @@index([organizationId])
  @@index([orderId])
  @@index([status])
  @@index([recollectionOfSampleId])
}

// Internal counter table backing org-scoped, year-scoped sequential patientUid
// generation. Incremented with a single atomic INSERT ... ON CONFLICT ... RETURNING
// so concurrent registrations can never produce a duplicate patientUid.
model UidCounter {
  id      String @id // `${organizationId}:${year}`
  orgId   String
  year    Int
  counter Int    @default(0)
}
